        {
          "node": "field",
          "name": "SynchronizedTargeting",
          "help": "Synchronized targetting determines if the weapon effects fire at the same spot on the target mesh or shield. If it's false then then the weapon effects can fire at random points on the target mesh or shield.",
          "validation": "Boolean"
        },
        {
          "node": "field",
          "name": "PointStaggerDelay",
