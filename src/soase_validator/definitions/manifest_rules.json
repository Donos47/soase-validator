{
  "entity.manifest": {
    "countKey": "entityNameCount",
    "nameKey": "entityName",
    "includesExtension": true,
    "example": "X.entity",
    "governs": {"directory": "GameInfo", "extensions": [".entity"]},
    "unlistedByBaseGame": []
  },
  "brush.manifest": {
    "countKey": "brushFileCount",
    "nameKey": "brushFile",
    "includesExtension": true,
    "example": "X.brushes",
    "governs": {"directory": "Window", "extensions": [".brushes"]}
  },
  "galaxy.manifest": {
    "countKey": "fileCount",
    "nameKey": "fileName",
    "includesExtension": false,
    "example": "Name",
    "governs": {"directory": "Galaxy", "extensions": [".galaxy"]}
  },
  "playerPictures.manifest": {
    "countKey": "fileCount",
    "nameKey": "fileName",
    "includesExtension": true,
    "example": "X.playerPictures",
    "governs": {"directory": "Window", "extensions": [".playerPictures"]}
  },
  "playerThemes.manifest": {
    "countKey": "fileCount",
    "nameKey": "fileName",
    "includesExtension": true,
    "example": "X.playerThemes",
    "governs": {"directory": "Window", "extensions": [".playerThemes"]}
  },
  "skybox.manifest": {
    "countKey": "meshFileCount",
    "nameKey": "meshFileName",
    "includesExtension": true,
    "example": "SkyboxBackdrop2.MESH",
    "governs": {"identifiedBy": "skyboxbackdropdata.meshName"}
  }
}
